<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Blueprint bytecode -> node graph decompiler, ported from UE Blueprint Graph Viewer
    (Copyright (c) 2026 glgen, MIT, see LICENSE-UEBlueprintGraphViewer.txt).
    UI independent; FModel hosts the WPF views.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>FModel.BlueprintGraph</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS8618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8625;CS8629</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutomaticGraphLayout" Version="1.1.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CUE4Parse\CUE4Parse-9539d4d86aef568f27957796249891d125d2c223\CUE4Parse\CUE4Parse.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Macros\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
