<UserControl x:Class="FModel.Views.AgentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#1E1F22">
    <Grid>
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#1E1F22" />
        <TextBlock x:Name="Fallback" Visibility="Collapsed" Margin="16" TextWrapping="Wrap" Foreground="#D0D0D0" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </Grid>
</UserControl>
