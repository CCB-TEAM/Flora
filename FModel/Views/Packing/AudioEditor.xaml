<UserControl x:Class="FModel.Views.Packing.AudioEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FModel.Localization">
    <StackPanel Margin="0 4 0 0">
        <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="InfoText" Opacity="0.75" Margin="0 4 0 8" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal">
            <Button x:Name="PlayButton" Content="{loc:Loc Pack_AudioPlay}" Padding="12 3" Click="OnPlayClick" />
            <Button Content="{loc:Loc Pack_AudioReplace}" Padding="12 3" Margin="6 0 0 0" Click="OnReplaceClick" />
            <Button x:Name="ExportButton" Content="{loc:Loc Pack_AudioExport}" Padding="12 3" Margin="6 0 0 0" Click="OnExportClick" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
            <Button Content="{loc:Loc Pack_AudioEncode}" Padding="12 3" Click="OnEncodeClick" />
            <TextBlock Text="{loc:Loc Pack_AudioQuality}" VerticalAlignment="Center" Margin="10 0 4 0" />
            <ComboBox x:Name="QualityBox" Width="60" SelectedIndex="4">
                <ComboBoxItem Content="0" /><ComboBoxItem Content="1" /><ComboBoxItem Content="2" /><ComboBoxItem Content="3" /><ComboBoxItem Content="4" />
                <ComboBoxItem Content="5" /><ComboBoxItem Content="6" /><ComboBoxItem Content="7" /><ComboBoxItem Content="8" /><ComboBoxItem Content="9" />
            </ComboBox>
        </StackPanel>
        <TextBlock Text="{loc:Loc Pack_AudioHint}" Opacity="0.6" Margin="0 8 0 0" TextWrapping="Wrap" />
        <TextBlock x:Name="ResultText" Margin="0 6 0 0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
