<UserControl x:Class="FModel.Views.Packing.PackWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FModel.Localization"
             xmlns:converters="clr-namespace:FModel.Views.Resources.Converters"
             xmlns:vm="clr-namespace:FModel.ViewModels"
             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
             xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI">
    <UserControl.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A90A0" />

        <!-- toolbar button -->
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12 5" />
            <Setter Property="Margin" Value="0 0 4 0" />
            <Setter Property="MinHeight" Value="28" />
        </Style>

        <!-- small label above a control -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0 0 0 2" />
        </Style>

        <!-- panel header -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- dark tree items: the default template falls back to a white selection outside of the main window -->
        <Style x:Key="PackTreeItemStyle" TargetType="{x:Type TreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <StackPanel>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="2 3 8 3" Margin="0 1"
                                    TextElement.Foreground="{TemplateBinding Foreground}">
                                <DockPanel>
                                    <ToggleButton x:Name="Expander" DockPanel.Dock="Left" Width="16" Height="16" Margin="0 0 2 0"
                                                  Focusable="False" ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border Background="Transparent">
                                                    <Path x:Name="Arrow" Data="M 5 3 L 10 8 L 5 13 Z" Fill="#8A90A0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="Data" Value="M 3 5 L 13 5 L 8 10 Z" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Arrow" Property="Fill" Value="#E6E8EE" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="14 0 0 0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E3340" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static adonisUi:Brushes.AccentBrush}}" />
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#34496A" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- file rows of the source browser -->
        <Style x:Key="PackListItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="8 4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- table of the pak -->
        <Style x:Key="PackColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Padding" Value="10 6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style x:Key="PackRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style x:Key="PackCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="8 0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static adonisUi:Brushes.Layer0BackgroundBrush}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- project bar -->
        <Border Grid.Row="0" Padding="12 10"
                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="0 0 0 1">
            <WrapPanel Orientation="Horizontal">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0 0 22 0">
                    <Button Style="{StaticResource BarButton}" Click="OnNewClick" ><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource AddIcon}" /></Canvas></Viewbox><TextBlock Text="{loc:Loc Pack_New}" Margin="7 0 0 0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource BarButton}" Click="OnOpenClick" ><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource DirectoryIcon}" /></Canvas></Viewbox><TextBlock Text="{loc:Loc Pack_Open}" Margin="7 0 0 0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource BarButton}" Click="OnSaveClick" ><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource SaveIcon}" /></Canvas></Viewbox><TextBlock Text="{loc:Loc Pack_Save}" Margin="7 0 0 0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource BarButton}" Click="OnSaveAsClick" ><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource ExportIcon}" /></Canvas></Viewbox><TextBlock Text="{loc:Loc Pack_SaveAs}" Margin="7 0 0 0" VerticalAlignment="Center" /></StackPanel></Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 0 22 0">
                    <StackPanel Margin="0 0 12 0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Pack_MountPoint}" />
                        <TextBox x:Name="MountPointBox" Width="110" MinHeight="28" VerticalContentAlignment="Center" LostFocus="OnSettingsChanged" />
                    </StackPanel>
                    <StackPanel Margin="0 0 12 0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Pack_PakVersion}" />
                        <ComboBox x:Name="VersionBox" Width="90" MinHeight="28" SelectionChanged="OnSettingsChanged" />
                    </StackPanel>
                    <CheckBox x:Name="CompressBox" Content="{loc:Loc Pack_Compress}" VerticalAlignment="Bottom" Margin="0 0 0 5" Click="OnSettingsChanged" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <ProgressBar IsIndeterminate="True" Width="70" Height="6" Margin="0 0 12 11" VerticalAlignment="Bottom"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Style="{DynamicResource {x:Static adonisUi:Styles.AccentButton}}" Padding="22 5" MinHeight="28" FontWeight="SemiBold" Click="OnBuildClick" ><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="White" Data="{StaticResource ExtractIcon}" /></Canvas></Viewbox><TextBlock Text="{loc:Loc Pack_Build}" Margin="7 0 0 0" VerticalAlignment="Center" /></StackPanel></Button>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.35*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- sources -->
            <Border Grid.Column="0" CornerRadius="4" Padding="10"
                    Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                    BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="90" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="1.4*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0 0 0 8">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource PanelTitle}" Text="{loc:Loc Pack_Sources}" />
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0 0 0 8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" MinHeight="28" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}" DisplayMemberPath="Name" />
                        <Button Grid.Column="1" Style="{StaticResource BarButton}" Margin="6 0 0 0" Click="OnAddFolderSourceClick" ><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource DirectoriesAddIcon}" /></Canvas></Viewbox><TextBlock Text="{loc:Loc Pack_AddFolder}" Margin="7 0 0 0" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button Grid.Column="2" Style="{StaticResource BarButton}" Margin="4 0 0 0" Click="OnAddPakSourceClick" ><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource ArchiveIcon}" /></Canvas></Viewbox><TextBlock Text="{loc:Loc Pack_AddPak}" Margin="7 0 0 0" VerticalAlignment="Center" /></StackPanel></Button>
                    </Grid>

                    <Border Grid.Row="2" CornerRadius="3" BorderThickness="1" Padding="4"
                            Background="{DynamicResource {x:Static adonisUi:Brushes.Layer0BackgroundBrush}}"
                            BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}">
                        <TreeView x:Name="FolderTree" BorderThickness="0" Background="Transparent" ItemsSource="{Binding Roots}"
                                  ItemContainerStyle="{StaticResource PackTreeItemStyle}"
                                  SelectedItemChanged="OnFolderSelected" PreviewMouseLeftButtonDown="OnTreePreviewMouseDown" PreviewMouseMove="OnTreePreviewMouseMove">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Flora;component/Resources/folder.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" Margin="0 0 7 0" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Border>

                    <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" MinHeight="28" VerticalContentAlignment="Center" Margin="0 0 0 6"
                                 Text="{Binding BrowseFilter, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                 adonisExtensions:WatermarkExtension.Watermark="{loc:Loc Pack_Search}" />
                        <Border Grid.Row="1" CornerRadius="3" BorderThickness="1"
                                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer0BackgroundBrush}}"
                                BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}">
                            <ListBox x:Name="BrowserList" BorderThickness="0" Background="Transparent" ItemsSource="{Binding BrowserFiles}" SelectionMode="Extended"
                                     ItemContainerStyle="{StaticResource PackListItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     PreviewMouseLeftButtonDown="OnListPreviewMouseDown" PreviewMouseMove="OnListPreviewMouseMove" MouseDoubleClick="OnBrowserDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True" ToolTip="{Binding Path}">
                                            <Viewbox DockPanel.Dock="Left" Width="14" Height="14" Margin="0 0 8 0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="#8A90A0" Data="{StaticResource AssetIcon}" /></Canvas></Viewbox>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Size, Converter={x:Static converters:SizeToStringConverter.Instance}}" Foreground="{StaticResource MutedBrush}" Margin="12 0 0 0" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Folder}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10 0 0 0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Button Grid.Row="2" Style="{StaticResource BarButton}" Margin="0 8 0 0" HorizontalAlignment="Stretch" Click="OnAddSelectedClick" ><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource ImportIcon}" /></Canvas></Viewbox><TextBlock Text="{loc:Loc Pack_AddSelected}" Margin="7 0 0 0" VerticalAlignment="Center" /></StackPanel></Button>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- the pak being built -->
            <Border Grid.Column="2" CornerRadius="4" Padding="10" AllowDrop="True" Drop="OnPackDrop" DragOver="OnPackDragOver"
                    Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                    BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="100" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0 0 0 8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0 0 0 8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" MinHeight="28" VerticalContentAlignment="Center"
                                 Text="{Binding PackFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 adonisExtensions:WatermarkExtension.Watermark="{loc:Loc Pack_Search}" />
                        <Button Grid.Column="1" Style="{StaticResource BarButton}" Margin="6 0 0 0" Click="OnAddFilesClick" ><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource AddIcon}" /></Canvas></Viewbox><TextBlock Text="{loc:Loc Pack_AddFiles}" Margin="7 0 0 0" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button Grid.Column="2" Style="{StaticResource BarButton}" Margin="4 0 0 0" Click="OnRemoveClick" ><StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource TrashIcon}" /></Canvas></Viewbox><TextBlock Text="{loc:Loc Pack_Remove}" Margin="7 0 0 0" VerticalAlignment="Center" /></StackPanel></Button>
                    </Grid>

                    <Border Grid.Row="2" CornerRadius="3" BorderThickness="1"
                            Background="{DynamicResource {x:Static adonisUi:Brushes.Layer0BackgroundBrush}}"
                            BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}">
                        <Grid>
                            <DataGrid x:Name="PackGrid" BorderThickness="0" Background="Transparent" ItemsSource="{Binding PackView}" AutoGenerateColumns="False" SelectionMode="Extended"
                                      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False" HeadersVisibility="Column"
                                      GridLinesVisibility="None" RowHeaderWidth="0"
                                      ColumnHeaderStyle="{StaticResource PackColumnHeader}" RowStyle="{StaticResource PackRow}" CellStyle="{StaticResource PackCell}"
                                      PreviewKeyDown="OnPackKeyDown" CellEditEnding="OnCellEditEnding" SelectionChanged="OnPackSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Pack_ColPath}" Binding="{Binding PakPath, Mode=OneWay}" IsReadOnly="False" Width="2*" />
                                    <DataGridTextColumn Header="{loc:Loc Pack_ColSize}" Binding="{Binding Size, Converter={x:Static converters:SizeToStringConverter.Instance}, Mode=OneWay}" IsReadOnly="True" Width="82" />
                                    <DataGridTextColumn Header="{loc:Loc Pack_ColOrigin}" Binding="{Binding Origin, Mode=OneWay}" IsReadOnly="True" Width="*" />
                                    <DataGridCheckBoxColumn Header="{loc:Loc Pack_ColModified}" Binding="{Binding Modified, Mode=OneWay}" IsReadOnly="True" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="24">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=PackGrid}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Viewbox Width="44" Height="44" HorizontalAlignment="Center" Margin="0 0 0 10"><Canvas Width="24" Height="24"><Path Fill="{StaticResource MutedBrush}" Data="{StaticResource ImportIcon}" /></Canvas></Viewbox>
                                <TextBlock Text="{loc:Loc Pack_DropHint}" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch" Background="Transparent" Visibility="{Binding Visibility, ElementName=EditorHost}" />
                    <Border Grid.Row="4" CornerRadius="3" BorderThickness="1" Padding="10 6 10 10" Visibility="{Binding Visibility, ElementName=EditorHost}"
                            Background="{DynamicResource {x:Static adonisUi:Brushes.Layer0BackgroundBrush}}"
                            BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}">
                        <ContentControl x:Name="EditorHost" Visibility="Collapsed" MaxHeight="420" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- status -->
        <Border Grid.Row="2" Padding="14 6"
                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}" BorderThickness="0 1 0 0">
            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" />
        </Border>
    </Grid>
</UserControl>
