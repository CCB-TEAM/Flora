<adonisControls:AdonisWindow x:Class="FModel.Views.ImportManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FModel"
        xmlns:converters="clr-namespace:FModel.Views.Resources.Converters"
        xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
        xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
        xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
        xmlns:loc="clr-namespace:FModel.Localization"
        WindowStartupLocation="CenterScreen"
        IconVisibility="Collapsed"
        MinHeight="400" MinWidth="700"
        Height="500" Width="800"
        Closing="OnClosing">
    <adonisControls:AdonisWindow.Style>
        <Style TargetType="adonisControls:AdonisWindow" BasedOn="{StaticResource {x:Type adonisControls:AdonisWindow}}" >
            <Setter Property="Title" Value="{loc:Loc ImportManager_Title}" />
        </Style>
    </adonisControls:AdonisWindow.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="10 10 10 5">
            <TextBlock Text="{loc:Loc ImportManager_Header}" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
            <TextBlock TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                       Text="{loc:Loc ImportManager_Description}" />
        </StackPanel>

        <!-- Search Box -->
        <Grid Grid.Row="1" Margin="10 5 10 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc ImportManager_Search}" VerticalAlignment="Center" Margin="0 0 10 0"/>
            <TextBox Grid.Column="1" Text="{Binding ImportManager.SearchText, UpdateSourceTrigger=PropertyChanged}" MinWidth="200"/>
        </Grid>

        <!-- Import List -->
        <GroupBox Grid.Row="2" adonisExtensions:LayerExtension.Layer="2" Margin="10 0 10 10"
                  Padding="{adonisUi:Space 0}" Background="Transparent">
            <Grid>
                <DataGrid ItemsSource="{Binding ImportManager.ImportsView}"
                          SelectedItem="{Binding ImportManager.SelectedImport}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="True"
                          CanUserSortColumns="True"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Import_Index}" Binding="{Binding Index}" Width="60"/>
                        <DataGridTextColumn Header="{loc:Loc Import_ClassPackage}" Binding="{Binding ClassPackage}" Width="200"/>
                        <DataGridTextColumn Header="{loc:Loc Import_ClassName}" Binding="{Binding ClassName}" Width="120"/>
                        <DataGridTextColumn Header="{loc:Loc Import_ObjectName}" Binding="{Binding ObjectName}" Width="200"/>
                        <DataGridTextColumn Header="{loc:Loc Import_OuterIndex}" Binding="{Binding OuterIndex}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State -->
                <TextBlock Text="{loc:Loc ImportManager_NoImports}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="14" Foreground="Gray"
                           Visibility="{Binding ImportManager.HasImports, Converter={converters:BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
            </Grid>
        </GroupBox>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                adonisExtensions:LayerExtension.IncreaseLayer="True">
            <Grid Margin="30, 12, 6, 12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc ImportManager_Total}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ImportManager.Imports.Count}" FontWeight="Bold" Margin="5 0 0 0" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  " VerticalAlignment="Center" Foreground="Gray" Margin="10 0 0 0"/>
                    <TextBlock Text="{loc:Loc Import_BlueprintJSONModifiedClickRefresh}" VerticalAlignment="Center"
                               Foreground="Orange" FontStyle="Italic"
                               Visibility="{Binding ImportManager.NeedsRefresh, Converter={converters:BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Content="{loc:Loc Common_Refresh}" MinWidth="78" Margin="0 0 12 0" Click="OnRefresh"/>
                    <Button MinWidth="78" Margin="0 0 12 0" IsDefault="True" IsCancel="False"
                            Content="{loc:Loc Common_Ok}" Click="OnClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</adonisControls:AdonisWindow>
