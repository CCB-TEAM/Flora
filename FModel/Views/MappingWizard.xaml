<UserControl xmlns:loc="clr-namespace:FModel.Localization" x:Class="FModel.Views.MappingWizard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
             xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
             Loaded="OnLoaded">
    <Grid Margin="10" adonisExtensions:LayerExtension.Layer="2" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap"
                   Text="{loc:Loc MappingWizard_UnversionedGameAssetsNeedAMappingFileUsm}" />

        <TextBlock Grid.Row="2" x:Name="CurrentText" TextWrapping="Wrap" FontWeight="SemiBold" />

        <ListView Grid.Row="4" x:Name="CandidateList" ItemsSource="{Binding Candidates}" SelectionMode="Single"
                  MouseDoubleClick="OnApplyClick" HorizontalContentAlignment="Stretch">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{loc:Loc MappingWizard_Tool}" Width="80" DisplayMemberBinding="{Binding Tool}" />
                    <GridViewColumn Header="{loc:Loc BlueprintEditor_ColumnType}" Width="55" DisplayMemberBinding="{Binding Kind}" />
                    <GridViewColumn Header="{loc:Loc MappingWizard_UE}" Width="50" DisplayMemberBinding="{Binding EngineVersion}" />
                    <GridViewColumn Header="{loc:Loc MappingWizard_File}" Width="260" DisplayMemberBinding="{Binding FileName}" />
                    <GridViewColumn Header="{loc:Loc MappingWizard_Modified}" Width="120" DisplayMemberBinding="{Binding ModifiedText}" />
                    <GridViewColumn Header="{loc:Loc Main_Info_Size}" Width="70" DisplayMemberBinding="{Binding SizeText}" />
                    <GridViewColumn Header="{loc:Loc MappingWizard_Folder}" Width="400" DisplayMemberBinding="{Binding Folder}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <Button Content="{loc:Loc MappingWizard_UseSelected}" MinWidth="110" Click="OnApplyClick"
                    Style="{DynamicResource {x:Static adonisUi:Styles.AccentButton}}" />
            <Button Content="{loc:Loc MappingWizard_Rescan}" MinWidth="80" Margin="8,0,0,0" Click="OnRescanClick" />
            <Button Content="{loc:Loc MappingWizard_Browse}" MinWidth="80" Margin="8,0,0,0" Click="OnBrowseClick" />
            <Button Content="{loc:Loc MappingWizard_OpenFolder}" MinWidth="90" Margin="8,0,0,0" Click="OnOpenFolderClick" />
            <TextBlock x:Name="StatusText" Margin="14,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Expander Grid.Row="8" Header="{loc:Loc MappingWizard_HowToGenerateAMappingFile}">
            <TextBlock Margin="6,6,0,0" TextWrapping="Wrap" x:Name="HelpText" />
        </Expander>
    </Grid>
</UserControl>
